# A small two-storey office building described with BOT + FireTwin-Lite.
# Room103 deliberately has NO smoke detector, to test the SHACL rule.
@prefix bot:  <https://w3id.org/bot#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ftl:  <https://example.org/firetwin#> .
@prefix b:    <https://example.org/firetwin/building#> .

b:Site a bot:Site ; bot:hasBuilding b:B1 .
b:B1 a bot:Building ; rdfs:label "Office building" ; bot:hasStorey b:S0, b:S1 .

b:S0 a bot:Storey ; rdfs:label "Ground floor" ;
    bot:hasSpace b:Lobby, b:Room001, b:Room002, b:Corridor0, b:Stair0 .
b:S1 a bot:Storey ; rdfs:label "First floor" ;
    bot:hasSpace b:Room101, b:Room102, b:Room103, b:Corridor1, b:Stair1 .

# Fire compartments are defined per storey (one compartment does not span floors)
b:CompA0 a ftl:FireCompartment ; rdfs:label "Compartment A0 (ground, west)" .
b:CompB0 a ftl:FireCompartment ; rdfs:label "Compartment B0 (ground, east)" .
b:CompA1 a ftl:FireCompartment ; rdfs:label "Compartment A1 (first, west)" .
b:CompB1 a ftl:FireCompartment ; rdfs:label "Compartment B1 (first, east)" .
# Stairwells are escape routes: modelled as a separate protected compartment
b:CompStair a ftl:FireCompartment ; rdfs:label "Protected stairwell" .

b:Lobby     a ftl:Room      ; rdfs:label "Lobby"      ; ftl:inCompartment b:CompA0 .
b:Room001   a ftl:Room      ; rdfs:label "Room 001"   ; ftl:inCompartment b:CompA0 .
b:Room002   a ftl:Room      ; rdfs:label "Room 002"   ; ftl:inCompartment b:CompB0 .
b:Corridor0 a ftl:Corridor  ; rdfs:label "Corridor 0" ; ftl:inCompartment b:CompA0 .
# Stairwells belong to the protected stairwell compartment
b:Stair0    a ftl:Stairwell ; rdfs:label "Stairwell (ground)" ; ftl:inCompartment b:CompStair .
b:Room101   a ftl:Room      ; rdfs:label "Room 101"   ; ftl:inCompartment b:CompA1 .
b:Room102   a ftl:Room      ; rdfs:label "Room 102"   ; ftl:inCompartment b:CompB1 .
b:Room103   a ftl:Room      ; rdfs:label "Room 103"   ; ftl:inCompartment b:CompB1 .
b:Corridor1 a ftl:Corridor  ; rdfs:label "Corridor 1" ; ftl:inCompartment b:CompB1 .
b:Stair1    a ftl:Stairwell ; rdfs:label "Stairwell (first)" ; ftl:inCompartment b:CompStair .

b:Lobby ftl:connectsTo b:Corridor0 .
b:Room001 ftl:connectsTo b:Corridor0 .
b:Room002 ftl:connectsTo b:Corridor0 .
b:Corridor0 ftl:connectsTo b:Stair0 .
b:Stair0 ftl:connectsTo b:Stair1 .
b:Stair1 ftl:connectsTo b:Corridor1 .
b:Room101 ftl:connectsTo b:Corridor1 .
b:Room102 ftl:connectsTo b:Corridor1 .
b:Room103 ftl:connectsTo b:Corridor1 .

b:ExitMain a ftl:EvacuationExit ; rdfs:label "Main exit" ; ftl:exitFrom b:Lobby .
b:ExitEast a ftl:EvacuationExit ; rdfs:label "East exit" ; ftl:exitFrom b:Corridor0 .

b:Lobby     bot:containsElement b:SD_Lobby, b:MCP_0, b:ExitMain .
b:Room001   bot:containsElement b:SD_001 .
b:Room002   bot:containsElement b:SD_002 .
b:Corridor0 bot:containsElement b:SD_C0, b:ExitEast .
b:Room101   bot:containsElement b:SD_101 .
b:Room102   bot:containsElement b:HD_102, b:SD_102 .
b:Room103   bot:containsElement b:HD_103 .
b:Corridor1 bot:containsElement b:SD_C1, b:MCP_1 .
# Smoke detectors in stairwells (required by SHACL rule 4)
b:Stair0    bot:containsElement b:SD_S0 .
b:Stair1    bot:containsElement b:SD_S1 .

# Fire doors between compartments, linked to both spaces with bot:adjacentElement
b:Room002   bot:adjacentElement b:FD_002 .
b:Corridor0 bot:adjacentElement b:FD_002, b:FD_S0 .
b:Stair0    bot:adjacentElement b:FD_S0 .
b:Stair1    bot:adjacentElement b:FD_S1 .
b:Corridor1 bot:adjacentElement b:FD_S1, b:FD_101 .
b:Room101   bot:adjacentElement b:FD_101 .

b:SD_Lobby a ftl:SmokeDetector . b:SD_001 a ftl:SmokeDetector . b:SD_002 a ftl:SmokeDetector .
b:SD_C0 a ftl:SmokeDetector .   b:SD_101 a ftl:SmokeDetector . b:SD_102 a ftl:SmokeDetector .
b:SD_C1 a ftl:SmokeDetector .   b:HD_102 a ftl:HeatDetector .  b:HD_103 a ftl:HeatDetector .
b:MCP_0 a ftl:ManualCallPoint . b:MCP_1 a ftl:ManualCallPoint .
# Stairwell smoke detectors
b:SD_S0 a ftl:SmokeDetector . b:SD_S1 a ftl:SmokeDetector .
# Fire doors
b:FD_002 a ftl:FireDoor ; rdfs:label "Fire door Room 002 / Corridor 0" .
b:FD_S0  a ftl:FireDoor ; rdfs:label "Fire door Corridor 0 / Stairwell" .
b:FD_S1  a ftl:FireDoor ; rdfs:label "Fire door Stairwell / Corridor 1" .
b:FD_101 a ftl:FireDoor ; rdfs:label "Fire door Room 101 / Corridor 1" .
